rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes to every collection go exclusively through the
    // server-only Firebase Admin SDK (see lib/firebase-admin.ts / lib/orders-server.ts),
    // which bypasses Security Rules entirely. No client (browser) ever reads or
    // writes Firestore directly in this app, so every path is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
